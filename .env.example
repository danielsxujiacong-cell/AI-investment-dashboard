# Copy to .env.local. Never commit .env.local.
FINNHUB_API_KEY=

# Optional OpenAI-compatible AI service credentials (never commit .env.local).
# Replace the endpoint and model together when switching providers.
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus

# Public Worker URL used by the GitHub Pages frontend after deployment.
# This URL is not a secret.
NEXT_PUBLIC_MARKET_API_BASE_URL=
